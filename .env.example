# Copy to .env and fill in. Everything here is optional — the app runs with no config.

# Google Cloud Text-to-Speech. Without it the server falls back to Google Translate's
# keyless tts endpoint, which works but is undocumented and rate-limited.
# Get one at https://console.cloud.google.com/apis/credentials (enable the
# Cloud Text-to-Speech API on the project first).
GOOGLE_TTS_KEY=

# Any Arabic voice name, e.g. ar-XA-Wavenet-A/B/C/D or ar-XA-Standard-A.
GOOGLE_TTS_VOICE=ar-XA-Wavenet-B

# API server port.
PORT=4030

# Client → API base URL (Vite build-time). Only needed if you move the API off :4030.
VITE_API_URL=http://localhost:4030
